# Only needed when running the core API outside Docker (npm start). Docker Compose reads the
# root .env generated by "make init" instead.
MONGODB_URI=mongodb://localhost:27017/jsonldDB
# Organization registry with users and scrypt password hashes (see config/organizations.example.json)
DVCT_ORGANIZATIONS_FILE=../../config/organizations.json
# Shared with the trace-api, at least 32 characters
DVCT_INTERNAL_API_TOKEN=
DVCT_SESSION_COOKIE_NAME=dvct_session
DVCT_SESSION_TTL_MS=28800000
DVCT_SESSION_SAME_SITE=Strict
DVCT_SESSION_SECURE=false
# Comma-separated browser origins allowed to call the API cross-origin (empty = same-origin only)
DVCT_CORS_ORIGINS=http://localhost:3000
