FROM node:20.19.0-alpine AS build

WORKDIR /app

COPY package.json ./
RUN npm install --no-audit --no-fund

COPY public ./public
COPY src ./src
COPY tsconfig.json ./

# Keep every script in a file so the Content-Security-Policy can forbid inline scripts.
ENV INLINE_RUNTIME_CHUNK=false \
    GENERATE_SOURCEMAP=false
RUN npm run build

# Gateway: serves the core frontend and routes /api, /incentive and /trace-api.
FROM nginxinc/nginx-unprivileged:1.31.7-alpine

COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
