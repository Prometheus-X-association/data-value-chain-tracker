# Copy to .env for local development (yarn dev). The env schema lives in src/env.js.

# Shows the development wallet switcher (uses Anvil's unlocked dev accounts)
NEXT_PUBLIC_ENVIRONMENT="development"
# Server-side: chain node the /incentive/rpc route forwards to
RPC_UPSTREAM_URL="http://127.0.0.1:8545"
# Server-side: lets /incentive/rpc forward signing methods to the node. Development only.
RPC_ALLOW_DEV_SIGNING="true"
